ENVIRONMENT=production
LOG_LEVEL=INFO

POSTGRES_DB=veya
POSTGRES_USER=veya
POSTGRES_PASSWORD=replace-with-a-strong-database-password
REDIS_PASSWORD=replace-with-a-strong-redis-password

JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
FRONTEND_APP_URL=https://app.example.com

MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=Veya <noreply@example.com>

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=https://app.example.com/api/integrations/instagram/callback
INSTAGRAM_TOKEN_ENCRYPTION_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

HTTP_PORT=8080

TRUST_PROXY_HEADERS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SIGNUP_PER_HOUR=20
RATE_LIMIT_FORGOT_PASSWORD_PER_HOUR=5
RATE_LIMIT_RESET_PASSWORD_PER_HOUR=10
RATE_LIMIT_REFRESH_PER_MINUTE=60
