# Backend
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://veya:veya@db:5432/veya

# Authentication
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30

# Transactional email
MAIL_PROVIDER=console
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
MAIL_FROM=Veya <onboarding@resend.dev>

# Instagram / Meta
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/integrations/instagram/callback
INSTAGRAM_AUTHORIZE_URL=https://www.instagram.com/oauth/authorize
INSTAGRAM_TOKEN_URL=https://api.instagram.com/oauth/access_token
INSTAGRAM_GRAPH_URL=https://graph.instagram.com
INSTAGRAM_LONG_LIVED_TOKEN_URL=https://graph.instagram.com/access_token
INSTAGRAM_REFRESH_TOKEN_URL=https://graph.instagram.com/refresh_access_token
INSTAGRAM_TOKEN_REFRESH_BEFORE_DAYS=7
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_comments
# Generate a Fernet key before connecting real accounts.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
FRONTEND_APP_URL=http://localhost:5173

# AI audience insights
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
INSIGHTS_MAX_COMMENTS=200
INSIGHTS_MAX_COMMENT_CHARS=600

# Background synchronization
REDIS_URL=redis://redis:6379/0
BACKGROUND_SYNC_INTERVAL_MINUTES=15
BACKGROUND_SYNC_SCHEDULER_SECONDS=60
BACKGROUND_SYNC_MAX_RETRIES=3
BACKGROUND_SYNC_RETRY_SECONDS=30
